{
  "name": "zelvyn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@fitsync/web run dev",
    "dev:web": "npm --workspace=@fitsync/web run dev",
    "dev:api": "npm --workspace=@fitsync/api run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --workspace=@fitsync/web run build",
    "build:api": "npm --workspace=@fitsync/api run build",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm --workspace=@fitsync/web run lint",
    "lint:api": "npm --workspace=@fitsync/api run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\"",
    "preview": "npm --workspace=@fitsync/web run preview"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
